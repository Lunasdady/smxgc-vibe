// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FundProduct {
  id                         Int      @id @default(autoincrement())
  productCode                String   // 产品代码
  dataDate                   DateTime // 数据所属日期，来源于文件名
  strategyType               String   // 策略标识，如 "index-enhanced-300"
  fundManager                String   // 基金管理人
  managerScale               String   // 原始管理人规模文本
  isLargeScale               Boolean  // 是否为"100亿元以上"
  productName                String   // 产品名称
  strategyCategory           String?  // 策略分类（二级分类）
  // === 旧字段（日期 < 2026-07-08）===
  weeklyReturn               Float?   // 近一周收益（%）
  monthlyReturn              Float?   // 近一月收益（%）
  ytdReturn                  Float?   // 今年以来收益（%）
  annualizedReturnSinceInception Float? // 成立以来年化收益（%）
  ytdMaxDrawdown             Float?   // 今年以来最大回撤（%）
  inceptionMaxDrawdown       Float?   // 成立以来最大回撤（%）
  annualizedVolatility       Float?   // 成立以来年化波动率（%）
  sharpeRatio                Float?   // 成立以来夏普比率

  // === 新字段（日期 >= 2026-07-08，仅指增策略和套利策略）===
  excessReturn1w             Float?   // 近一周超额收益（%）
  excessReturn3m             Float?   // 近三月超额收益（%）
  excessReturnYtd            Float?   // 今年以来超额收益（%）
  excessAnnualizedReturn     Float?   // 成立以来超额年化收益（%）
  excessYtdMaxDrawdown       Float?   // 今年以来超额最大回撤（%）
  excessInceptionMaxDrawdown Float?   // 成立以来超额最大回撤（%）
  excessAnnualizedVolatility Float?   // 成立以来超额年化波动率（%）
  excessSharpeRatio          Float?   // 成立以来超额夏普比率
  karmaRatio                 Float?   // 成立以来卡玛比率（套利策略）

  createdAt                  DateTime @default(now())

  @@unique([productCode, dataDate])
  @@index([dataDate])
  @@index([dataDate, strategyType])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phone        String?
  realName     String
  organization String
  department   String?
  position     String?
  referrer     String?  // 推荐人
  password     String   // bcrypt hash
  permissions  String   @default("[]") // JSON数组，如 ["strategy-detail"]
  status       String   @default("pending") // pending / approved / rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  type      String   // register / forgot-password
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     // 已登录用户ID(未登录为null)
  page      String   // 访问页面路径
  ip        String?  // IP地址
  userAgent String?  // 浏览器UA
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([page, createdAt])
  @@index([userId, createdAt])
}

model EmailConfig {
  id                Int      @id @default(autoincrement())
  email             String   @unique // 邮箱地址
  imapHost          String   // IMAP服务器地址
  imapPort          Int      @default(993) // IMAP端口
  passwordEncrypted String   // AES加密的密码
  sslEnabled        Boolean  @default(true) // 是否启用SSL
  enabled           Boolean  @default(true) // 是否启用
  lastParsedAt      DateTime? // 最后解析时间
  lastParsedUid     String?  // 最后解析的邮件UID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parseResults      EmailParseResult[]

  @@index([enabled])
}

model EmailParseResult {
  id               Int      @id @default(autoincrement())
  emailUid         String   // 邮件UID
  subject          String   // 邮件主题
  fromEmail        String?  // 发件人
  sentDate         DateTime? // 邮件发送日期
  receivedAt       DateTime // 邮件接收时间
  emailConfigId    Int      // 关联邮箱配置
  htmlParsed       Boolean  @default(false) // HTML是否解析成功
  excelParsed      Boolean  @default(false) // Excel是否解析成功
  parseStatus      String   // success / failed / skipped
  recordCount      Int      @default(0) // 解析记录数
  errorReason      String?  // 失败原因
  rawData          String?  // 原始解析数据(JSON格式,用于诊断)
  createdAt        DateTime @default(now())

  emailConfig      EmailConfig @relation(fields: [emailConfigId], references: [id])
  navData          NavData[]

  @@index([emailConfigId])
  @@index([parseStatus])
  @@index([receivedAt])
}

model NavData {
  id                  Int      @id @default(autoincrement())
  productCode         String   // 产品代码
  productName         String   // 产品名称
  navDate             DateTime // 净值日期
  unitNav             Float?   // 单位净值
  cumulativeNav       Float?   // 累计净值
  source              String   // html / excel / vertical
  confidence          String   @default("medium") // high / medium / low
  emailParseResultId  Int?     // 关联解析结果
  createdAt           DateTime @default(now())

  emailParseResult  EmailParseResult? @relation(fields: [emailParseResultId], references: [id])

  @@unique([productCode, navDate])
  @@index([productCode])
  @@index([navDate])
  @@index([productName])
  @@index([emailParseResultId])
}

// 产品策略类型映射表
model StrategyMapping {
  id                  Int      @id @default(autoincrement())
  productCode         String   // 产品代码
  productName         String   // 产品名称
  primaryStrategy     String   // 一级策略
  secondaryStrategy   String   // 二级策略
  category            String   // 分类分层（观察池等）
  fundManager         String?  // 基金管理人
  managerScale        String?  // 管理人规模
  updatedAt           DateTime @default(now()) @updatedAt
  createdAt           DateTime @default(now())

  @@unique([productCode])
  @@index([productCode])
  @@index([primaryStrategy])
  @@index([secondaryStrategy])
  @@index([category])
}

// 基准指数数据表
model IndexData {
  id          Int      @id @default(autoincrement())
  indexCode   String   // 指数代码：000300.SH
  indexName   String   // 指数名称：沪深300
  tradeDate   DateTime // 交易日期
  closePrice  Float    // 收盘价
  dailyReturn Float?   // 日收益率
  createdAt   DateTime @default(now())

  @@unique([indexCode, tradeDate])
  @@index([indexCode])
  @@index([tradeDate])
}

// 策略-指数映射表
model IndexMapping {
  id              Int      @id @default(autoincrement())
  secondaryStrategy String @unique // 二级策略名称
  indexCode       String   // 基准指数代码
  indexName       String   // 基准指数名称
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([secondaryStrategy])
  @@index([indexCode])
}

// 策略类型字典表
model StrategyDictionary {
  id                  Int      @id @default(autoincrement())
  level               Int      // 1=一级策略, 2=二级策略
  parentStrategy      String?  // 二级策略的父级（一级策略）
  strategyName        String   // 策略名称
  sortOrder           Int      @default(0)  // 排序顺序
  isActive            Boolean  @default(true)  // 是否启用
  updatedAt           DateTime @default(now()) @updatedAt
  createdAt           DateTime @default(now())

  @@unique([level, parentStrategy, strategyName])
  @@index([level])
  @@index([parentStrategy])
}

// 解析日志表 - 用于详细记录每封邮件的解析过程
model ParseLog {
  id                  Int      @id @default(autoincrement())
  emailUid            String   // 邮件UID
  subject             String   // 邮件主题
  emailConfigId       Int      // 邮箱配置ID
  
  // 邮件内容信息
  hasAttachments      Boolean  @default(false) // 是否有附件
  attachmentCount     Int      @default(0)     // 附件数量
  attachmentTypes     String?  // 附件MIME类型(JSON数组)
  attachmentFilenames String?  // 附件文件名(JSON数组)
  hasHtml             Boolean  @default(false) // 是否有HTML
  htmlLength          Int      @default(0)     // HTML长度
  
  // 解析过程信息
  parseAttempts       String   // 解析尝试(JSON对象)
  parseResults        String?  // 解析结果(JSON对象)
  
  // 失败信息
  errorReason         String?  // 失败原因
  errorDetails        String?  // 详细错误信息
  
  createdAt           DateTime @default(now())
  
  @@index([emailUid])
  @@index([emailConfigId])
  @@index([createdAt])
}

// 诊断报告表 - 记录自诊断分析结果
model DiagnosticReport {
  id                  Int      @id @default(autoincrement())
  report              String   // JSON格式的诊断报告
  failedCount         Int      @default(0)     // 失败邮件数量
  successRate         Float    @default(0)     // 成功率百分比
  suggestionsCount    Int      @default(0)     // 优化建议数量
  createdAt           DateTime @default(now())
  
  @@index([createdAt])
}

// 优化记录表 - 记录每次自动优化的详情
model OptimizationRecord {
  id                  Int      @id @default(autoincrement())
  timestamp           DateTime @default(now()) // 优化时间
  
  // 优化前状态
  beforeSuccessRate   Float    @default(0)     // 优化前成功率
  beforeFailedCount   Int      @default(0)     // 优化前失败数
  
  // 优化内容
  optimizations       String   // JSON数组,记录所有优化项
  newAliases          String?  // 新增的字段别名(JSON数组)
  newStrategies       String?  // 新增的解析策略(JSON数组)
  
  // 优化后状态
  afterSuccessRate    Float?   // 优化后成功率
  afterFailedCount    Int?     // 优化后失败数
  improvedCount       Int?     // 成功修复的邮件数
  
  // 验证结果
  validationReport    String?  // JSON格式的验证报告
  
  createdAt           DateTime @default(now())
  
  @@index([createdAt])
  @@index([timestamp])
}

model ParseRule {
  id        Int      @id @default(autoincrement())
  ruleType  String   // field_alias / filter_keyword / parse_strategy
  ruleKey   String   // 规则键
  ruleValue String   // 规则值
  enabled   Boolean  @default(true) // 是否启用
  createdAt DateTime @default(now())

  @@index([ruleType])
  @@index([enabled])
}

model ParseTask {
  id          String   @id // taskId: parse_{configId}_{timestamp}
  configId    Int      // 邮箱配置ID
  progress    Int      @default(0) // 进度百分比 0-100
  total       Int      @default(0) // 总邮件数
  current     Int      @default(0) // 当前处理数
  status      String   @default("pending") // pending / processing / completed / failed / cancelled
  message     String   @default("等待解析...") // 状态消息
  fullParse   Boolean  @default(false) // 是否全量解析
  testLimit   Int?     // 测试解析限制数量
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([configId])
  @@index([createdAt])
}
